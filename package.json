{
  "name": "raycasting-webassembly-demo",
  "version": "1.0.0",
  "description": "WebAssembly Raycasting demo",
  "license": "MIT",
  "author": "Andrea Collet <info@andreacollet.com>",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "node ./tools/check_server_and_start.js",
    "dev:internal": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build": "npm run build:wasm && npm run build:web",
    "pretest": "npm run build",
    "test": "node tools/run_tests.js",
    "format": "prettier --write \"**/*.{js,svelte,json,css,html,md}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "puppeteer": "^25.15.0",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "puppeteer@25.14.0": true,
    "fsevents@2.3.3": true
  }
}
