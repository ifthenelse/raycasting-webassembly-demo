{
  "name": "raycasting-webassembly-demo",
  "version": "1.0.0",
  "description": "WebAssembly Raycasting demo",
  "license": "MIT",
  "author": "Andrea Collet <info@andreacollet.com>",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "node ./tools/check_server_and_start.js",
    "dev:internal": "vite",
    "build:web": "vite build",
    "preview": "vite preview",
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build": "npm run build:wasm && npm run build:web",
    "test": "node tools/run_tests.js",
    "format": "prettier --write \"**/*.{js,svelte,json,css,html,md}\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "puppeteer": "^24.34.0",
    "svelte": "^5.46.1",
    "vite": "^7.3.0"
  }
}
