{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.exclude": {
      "**/node_modules": true,
      "**/pkg": true,
      "**/target": true,
      "**/dist": true,
    },
    "specstory.cloudSync.enabled": "never",
  },
  "extensions": {
    "recommendations": ["esbenp.prettier-vscode", "svelte.svelte-vscode"],
  },
}
